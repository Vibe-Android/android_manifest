<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="vibe"
           fetch="https://github.com/Vibe-Android"
           revision="refs/heads/lineage-23.2" />

  <!-- Vibe additions -->
  <project path="vendor/vibe" name="android_vendor_vibe" remote="vibe" />
  <project path="packages/apps/VibeParts" name="android_packages_apps_VibeParts" remote="vibe" />

  <!-- Vibe overrides of LineageOS repositories -->
  <remove-project name="LineageOS/android_packages_apps_Settings" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="vibe" />

  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="vibe" />

</manifest>
